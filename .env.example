# Simulator-safe defaults. Copy this file outside the repository or export the
# values in your shell. Never commit the populated file.
LIGHTPHONE_GPT_STATE_DIR=/tmp/lightphone-gpt-demo
LIGHTPHONE_GPT_PROVIDER=simulator
LIGHTPHONE_GPT_ASSISTANT=mock
LIGHTPHONE_GPT_TRANSCRIBER=simulated-envelope
LIGHTPHONE_GPT_HEALTH_HOST=127.0.0.1
LIGHTPHONE_GPT_HEALTH_PORT=8824
LIGHTPHONE_GPT_POLL_SECONDS=5
LIGHTPHONE_GPT_OUTPUT_MODE=rolling
LIGHTPHONE_GPT_OUTPUT_TITLE=AI READY
LIGHTPHONE_GPT_LOCAL_TIMEZONE=UTC
LIGHTPHONE_GPT_DELETE_SOURCE_AFTER_PUBLISH=false

# Real adapters are deliberately inactive. See docs/installation.md before
# setting any of these values.
# lightphone_username=<account email>
# lightphone_password=<account password>
# LIGHTPHONE_GPT_PROVIDER=light
# LIGHTPHONE_GPT_ASSISTANT=chatgpt
# LIGHTPHONE_GPT_TRANSCRIBER=faster-whisper
# LIGHTPHONE_GPT_FASTER_WHISPER_CACHE=/absolute/private/model-cache
# LIGHTPHONE_GPT_CHATGPT_CREDENTIAL_FILE=/absolute/private/credentials.json
# LIGHTPHONE_GPT_CHATGPT_HOST_ID_FILE=/absolute/private/host-id
# LIGHTPHONE_GPT_CHATGPT_MODEL=<account-visible model>
# LIGHTPHONE_GPT_PRODUCTION_ACTIVATION=ENABLE_REAL_LIGHT_AND_CHATGPT_V1
